{
  "name": "absign-integration",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && tsx watch src/index.ts",
    "start": "npm run db:migrate && tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:integration": "npm run db:migrate && RUN_POSTGRES_TESTS=true vitest run tests/integration",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "multer": "^2.3.0",
    "pg": "8.23.0",
    "socket.io": "4.8.3",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.10",
    "socket.io-client": "^4.8.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
